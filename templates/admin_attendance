<h2>All Student Attendance (Admin View)</h2>

<table border="1">
<tr>
    <th>Name</th>
    <th>Email</th>
    <th>Date</th>
    <th>Status</th>
</tr>

{% for r in records %}
<tr>
    <td>{{ r[0] }}</td>
    <td>{{ r[1] }}</td>
    <td>{{ r[2] }}</td>
    <td>{{ r[3] }}</td>
</tr>
{% endfor %}
</table>
